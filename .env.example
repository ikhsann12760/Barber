# Database
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Bot Configuration
BOT_PORT=3001

# WhatsApp API (e.g., using a provider like Fonnte, Wablas, or official Cloud API)
WA_API_URL="https://api.your-wa-provider.com/send"
